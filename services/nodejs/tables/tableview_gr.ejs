<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Production Schedule | NexERP</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body { height: 100%; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f5f7fa; height: 100vh; width: 100vw; overflow-x: hidden; }
        .container-fluid { width: 100vw !important; max-width: 100vw !important; padding: 0 !important; margin: 0 !important; }
        .row, .col-12 { margin: 0 !important; padding: 0 !important; }
        .card { border-radius: 0; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 0; border: none; width: 100vw; }
        .card-header { background: linear-gradient(135deg, #0669f4, #5441e9); color: white; border-radius: 0; font-weight: 600; padding: 15px 20px; font-size: 14px; display: flex; justify-content: space-between; align-items: center; }
        .card-header h5 { margin-bottom: 0; font-weight: 600; color: white; }
        .btn-primary { background-color: #0669f4; border-color: #0669f4; }
        .btn-primary:hover { background-color: #0558d6; border-color: #0558d6; }
        .btn-light { background-color: #ffffff; border-color: #dee2e6; color: #212529; }
        .btn-light:hover { background-color: #f8f9fa; border-color: #c6ccd2; }
        .table-responsive { width: 100vw; overflow-x: visible !important; }
        #prodTable { font-size: 14px; width: 100vw; min-width: 100vw; max-width: 100vw; table-layout: fixed; }
        #prodTable thead th { font-size: 15px; font-weight: 600; }
        .table th { background-color: #f8f9fa; font-weight: 600; white-space: nowrap; color: #3c4b64; border-top: none; text-align: center; position: relative; cursor: pointer; }
        .table th.sort-asc:after { content: '↑'; position: absolute; right: 8px; color: #0669f4; }
        .table th.sort-desc:after { content: '↓'; position: absolute; right: 8px; color: #0669f4; }
        .table td { vertical-align: middle; text-align: center; }
        .table-hover tbody tr:hover { background-color: rgba(6, 105, 244, 0.05); }
        .badge { font-weight: 500; padding: 0.5em 0.75em; }
        .pagination-container { display: flex; justify-content: space-between; align-items: center; margin-top: 20px; }
        .pagination { margin-bottom: 0; }
        .pagination .page-link { color: #0669f4; }
        .pagination .page-item.active .page-link { background-color: #0669f4; border-color: #0669f4; }
        @media (max-width: 1200px) {
            #prodTable th, #prodTable td { font-size: 12px; }
        }
        @media (max-width: 768px) {
            .card-header, .card-body { padding: 8px !important; }
            #prodTable th, #prodTable td { font-size: 10px; padding: 2px; }
        }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <a href="/page/ai_optimizer" class="btn btn-outline-light btn-sm me-2">
                            <i class="fas fa-arrow-left me-1"></i>Back To AI Optimizer
                        </a>
                        <span class="ms-2 fs-5">Production Schedule</span>
                    </div>
                    <a href="/input" class="btn btn-light btn-sm">
                        <i class="fas fa-plus me-1"></i>Add New Job
                    </a>
                </div>
                <div class="card-body">
                    <!-- Search and filter controls -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <form class="input-group" method="get">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" name="search" class="form-control" placeholder="Search job, process code..." value="<%= search %>">
                                <button class="btn btn-primary ms-2" type="submit">
                                    <i class="fas fa-filter me-1"></i>Apply Filters
                                </button>
                            </form>
                        </div>
                        <div class="col-md-6 text-end">
                            <form class="d-flex justify-content-end align-items-center" method="get">
                                <input type="hidden" name="search" value="<%= search %>">
                                <label class="me-2 text-nowrap">Show</label>
                                <select name="pageSize" class="form-select me-2" style="width: auto;" onchange="this.form.submit()">
                                    <% [50, 100, 250, 500].forEach(function(size) { %>
                                        <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %> per page</option>
                                    <% }) %>
                                </select>
                                <span>entries</span>
                            </form>
                        </div>
                    </div>
                    <!-- Table -->
                    <div class="table-responsive">
                        <table id="prodTable" class="table table-hover">
                            <thead>
                                <tr>
                                    <% const columns = [
                                        { key: 'LCD_DATE', label: 'LCD DATE' },
                                        { key: 'TxnId_i', label: 'TXN ID' },
                                        { key: 'START_DATE', label: 'START DATE' },
                                        { key: 'MATERIAL_ARRIVAL', label: 'MATERIAL ARRIVAL' },
                                        { key: 'JOB', label: 'JOB' },
                                        { key: 'PROCESS_CODE', label: 'PROCESS CODE' },
                                        { key: 'RSC_LOCATION', label: 'RSC LOCATION' },
                                        { key: 'RSC_CODE', label: 'RSC CODE' },
                                        { key: 'JOB_DEPENDENCY', label: 'JOB DEPEND' },
                                        { key: 'NUMBER_OPERATOR', label: 'NO OPR' },
                                        { key: 'JOB_QUANTITY', label: 'JOB QUANTITY' },
                                        { key: 'ACCUMULATED_DAILY_OUTPUT', label: 'DAILY OUTPUT' },
                                        { key: 'BALANCE_QUANTITY', label: 'BALANCE QUANTITY' },
                                        { key: 'HOURS_NEED', label: 'HOURS NEED' },
                                        { key: 'DAY_NEED', label: 'DAY NEED' },
                                        { key: 'SETTING_HOURS', label: 'SETUP HOURS' },
                                        { key: 'BREAK_HOURS', label: 'BREAK HOURS' },
                                        { key: 'NO_PROD', label: 'NO PROD' },
                                        { key: 'PRIORITY', label: 'PRIORITY' },
                                        { key: 'REDUCE_OPERATION_HOURS', label: 'REDUCE HRS' },
                                        { key: 'ACTIONS', label: 'ACTIONS' }
                                    ]; %>
                                    <% columns.forEach(function(col) { %>
                                        <% if (col.key !== 'ACTIONS') { %>
                                            <th>
                                                <a href="?<%= buildQueryString(Object.assign({}, currentQuery, { sortField: col.key, sortOrder: sortField === col.key && sortOrder === 'ASC' ? 'DESC' : 'ASC', page: 1 })) %>">
                                                    <%= col.label %>
                                                    <% if (sortField === col.key) { %>
                                                        <%= sortOrder === 'ASC' ? '↑' : '↓' %>
                                                    <% } %>
                                                </a>
                                            </th>
                                        <% } else { %>
                                            <th><%= col.label %></th>
                                        <% } %>
                                    <% }) %>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (jobs.length === 0) { %>
                                    <tr><td colspan="21">No data found</td></tr>
                                <% } else { %>
                                    <% jobs.forEach(function(job) { %>
                                        <tr>
                                            <td><%= job.LCD_DATE || 'N/A' %></td>
                                            <td><%= job.TxnId_i %></td>
                                            <td><%= job.START_DATE || 'N/A' %></td>
                                            <td><%= job.MATERIAL_ARRIVAL || 'N/A' %></td>
                                            <td><%= job.JOB %></td>
                                            <td><%= job.PROCESS_CODE %></td>
                                            <td><%= job.RSC_LOCATION %></td>
                                            <td><%= job.RSC_CODE %></td>
                                            <td><%= job.JOB_DEPENDENCY ? 'Yes' : 'No' %></td>
                                            <td><%= job.NUMBER_OPERATOR %></td>
                                            <td><%= job.JOB_QUANTITY %></td>
                                            <td><%= job.ACCUMULATED_DAILY_OUTPUT %></td>
                                            <td><%= job.BALANCE_QUANTITY %></td>
                                            <td><%= job.HOURS_NEED %></td>
                                            <td><%= job.DAY_NEED %></td>
                                            <td><%= job.SETTING_HOURS %></td>
                                            <td><%= job.BREAK_HOURS %></td>
                                            <td><%= job.NO_PROD %></td>
                                            <td><%= job.PRIORITY %></td>
                                            <td><%= job.REDUCE_OPERATION_HOURS %></td>
                                            <td><!-- Actions: add edit/delete/view links if needed --></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <div class="pagination-container">
                        <div id="tableInfo">
                            Showing <%= (currentPage - 1) * pageSize + 1 %> to <%= Math.min(currentPage * pageSize, totalItems) %> of <%= totalItems %> entries
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination">
                                <% for (let i = 1; i <= totalPages; i++) { %>
                                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                        <a class="page-link" href="?<%= buildQueryString(Object.assign({}, currentQuery, { page: i })) %>"><%= i %></a>
                                    </li>
                                <% } %>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
